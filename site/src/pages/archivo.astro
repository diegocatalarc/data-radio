---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { regionByKey } from '../regions';

const all = (await getCollection('notas')).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('es-CL', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' }).replace('.', '');
---
<Base title="Archivo">
  <section class="archive">
    <h1 class="rv">Archivo</h1>
    <ul class="stories">
      {all.map((n) => (
        <li class="story rv">
          <a href={`/nota/${n.id}`}>
            <time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>
            <div>
              <span class="region-tag">{regionByKey[n.data.region].short}</span>
              <h3 style="display:block;margin-top:.25rem">{n.data.title}</h3>
            </div>
            <span class="arrow">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
